# Copy this file to .env and fill in the values. .env is gitignored.
# The app will not boot without SECRET_KEY — it has no default on purpose.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Never leave this on outside local development.
DEBUG=True

# Only needed when running outside Docker Compose; the compose file sets
# these to redis://redis:6379/0, since "localhost" inside a container is
# the container itself, not the host.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Origins allowed to call the API from a browser (comma-separated, no
# trailing slash). Defaults to the Vite dev server; set the real domain in
# production. Anything not listed here is rejected by the browser.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
